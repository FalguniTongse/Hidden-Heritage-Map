# Copy to server/.env  (secrets live ONLY on the backend)
PORT=4000
# Optional: enables real AI (categorize, translate, story structuring, quiz drafts, search assistant).
# Without it the app uses built-in rule-based fallbacks so the demo always works.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
# Optional: Cloudinary for media (prototype stores uploads on local disk)
CLOUDINARY_URL=
# Optional: Firebase Admin (prototype uses a demo login)
FIREBASE_PROJECT_ID=
